; L-bracket with mounting holes
;
; Demonstrates: union, difference, rotate, let bindings

[let t 4.0]                    ; material thickness
[let hole [cylinder 3.0 6.0]]  ; reusable M6 bolt hole tool

; base plate 60×40mm
[pipe [cube 60.0 40.0 t]
  ; upright wall at back edge
  [union [translate 0.0 0.0 t [cube 60.0 t 36.0]]]
  ; base plate holes (vertical, through base)
  [difference [translate 10.0 20.0 -1.0 hole]]
  [difference [translate 50.0 20.0 -1.0 hole]]
  ; wall holes (rotated 90° to go through wall horizontally)
  [difference [translate 10.0 -1.0 26.0 [rotate 90.0 0.0 0.0 hole]]]
  [difference [translate 50.0 -1.0 26.0 [rotate 90.0 0.0 0.0 hole]]]]
