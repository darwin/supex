; Robot mascot — CSG primitives only
;
; Demonstrates: intersection, scale, sphere, union of many parts
; All geometry is built from basic primitives — no imports.
; Feet sit on z=0, total height ~75mm.

; horizontal cylinder template for arms (centered, rotated to X axis)
[let arm [rotate 0.0 90.0 0.0
  [translate 0.0 0.0 -9.0 [cylinder 3.5 18.0]]]]

; body: cube ∩ stretched sphere → rounded box shape
[pipe [translate 0.0 0.0 27.0
    [intersection
      [scale 1.0 1.0 1.1 [sphere 24.0]]
      [translate -16.0 -12.0 -20.0 [cube 32.0 24.0 40.0]]]]
  ; head — slightly squished sphere
  [union [translate 0.0 0.0 51.0 [scale 1.0 0.9 0.95 [sphere 16.0]]]]
  ; eyes (left, right)
  [union [translate -7.0 -12.0 54.0 [sphere 3.5]]]
  [union [translate 7.0 -12.0 54.0 [sphere 3.5]]]
  ; pupils — smaller, pushed forward
  [union [translate -7.0 -14.5 54.0 [sphere 2.0]]]
  [union [translate 7.0 -14.5 54.0 [sphere 2.0]]]
  ; antenna stalk + ball
  [union [translate 0.0 0.0 57.0 [cylinder 1.5 14.0]]]
  [union [translate 0.0 0.0 72.0 [sphere 3.5]]]
  ; arms (reusing template) + spherical hands
  [union [translate -24.0 0.0 31.0 arm]]
  [union [translate 24.0 0.0 31.0 arm]]
  [union [translate -34.0 0.0 31.0 [sphere 4.5]]]
  [union [translate 34.0 0.0 31.0 [sphere 4.5]]]
  ; legs
  [union [translate -8.0 0.0 -3.0 [cylinder 4.5 12.0]]]
  [union [translate 8.0 0.0 -3.0 [cylinder 4.5 12.0]]]
  ; feet — flat rounded cubes
  [union [translate -14.0 -8.0 0.0 [cube 12.0 14.0 4.0]]]
  [union [translate 2.0 -8.0 0.0 [cube 12.0 14.0 4.0]]]
  ; chest detail — small disk facing forward
  [union [translate 0.0 -13.0 29.0
    [rotate 90.0 0.0 0.0 [translate 0.0 0.0 -1.0 [cylinder 6.0 2.0]]]]]]
